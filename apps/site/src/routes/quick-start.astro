---
import Layout from '../layouts/StandardLayout.astro';
import { currentSite } from '../lib/site';
import { agdrVersionBanner } from '../lib/agdr-changelog';
const example = `{
  "specVersion": "0.1",
  "id": "plan-authentication",
  "revision": 1,
  "project": { "id": "customer-platform" },
  "title": "Corporate SSO",
  "intent": "Internal users authenticate through corporate SSO.",
  "outcomes": [{ "id": "sso", "title": "Corporate users can authenticate using SSO." }],
  "acceptanceCriteria": [{ "id": "ac-1", "outcomeId": "sso", "statement": "Corporate SSO login succeeds." }]
}`;
---
{currentSite(import.meta.env.PUBLIC_SITE_KEY) === 'agdr' ? <Layout title="Quick Start"><section class="page"><p class="eyebrow">{agdrVersionBanner}</p><h1>Create your first AgDR in five minutes.</h1><p class="lede">Copy the template, record one consequential technical decision, and validate it against the published schema.</p><div class="card-grid"><article class="card"><h2>Zero dependency</h2><p>Copy <code>agdr-template.md</code>, fill the frontmatter and decision body, then run the repository validator.</p></article><article class="card"><h2>Agent integrations</h2><p>AgDR has integration guidance for Claude Code, Codex, Cursor, Copilot, Windsurf and generic agent prompts.</p></article></div><a class="button" href="https://github.com/me2resh/agent-decision-record/blob/main/agdr-template.md">Use the template</a></section></Layout> : <Layout title="Quick Start"><section class="page"><p class="eyebrow">ORBIT v0.1 · Draft</p><h1>Start with one outcome.</h1><p class="lede">Install the CLI, write one Plan, then observe, reconcile, and sync a bounded slice.</p><pre class="code">{example}</pre>

<h2>Install</h2>
<p>The npm package is not published yet. Install the CLI from the v0.1.0 tag:</p>
<pre class="code">npm install -g github:me2resh/orbit-spec#v0.1.0</pre>
<p>Or, in Claude Code, add the marketplace and install the plugin:</p>
<pre class="code">/plugin marketplace add me2resh/apexyard
/plugin install orbit@apexyard</pre>
<p>The plugin runs the same <code>orbit</code> CLI. Until the npm package is published, install the CLI with the GitHub install command above.</p>

<h2>Run</h2>
<p>Check whether the latest Reconciliation is still current:</p>
<pre class="code">orbit status --root orbit</pre>
<p>Render plan progress as Markdown with a Mermaid graph:</p>
<pre class="code">orbit progress --root orbit</pre>
<p>Preview a GitHub issue for one Execution Slice (no write):</p>
<pre class="code">orbit sync github \
  --plan orbit/plans/plan.json \
  --snapshot orbit/snapshots/snapshot.json \
  --reconciliation orbit/reconciliations/reconciliation.json \
  --slice orbit/slices/slice.json \
  --repo owner/repository \
  --dry-run</pre>

<h2>Observe, reconcile, execute</h2>
<p>Observe current project state. Reconcile the plan against that state. Generate one bounded slice. Execute through the provider of your choice. Repeat.</p>
<p><a class="button quiet" href="/adopter-guide">Open the adopter guide</a></p>
</section></Layout>}
