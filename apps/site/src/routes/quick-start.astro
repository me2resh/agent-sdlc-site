---
import Layout from '../layouts/StandardLayout.astro';
import { currentSite } from '../lib/site';
import { agdrVersionBanner } from '../lib/agdr-changelog';
const example = `{
  "specVersion": "0.1",
  "id": "plan-authentication",
  "revision": 1,
  "project": { "id": "customer-platform" },
  "title": "Corporate SSO",
  "intent": "Internal users authenticate through corporate SSO.",
  "outcomes": [{ "id": "sso", "title": "Corporate users can authenticate using SSO." }],
  "acceptanceCriteria": [{ "id": "ac-1", "outcomeId": "sso", "statement": "Corporate SSO login succeeds." }]
}`;
---
{currentSite(import.meta.env.PUBLIC_SITE_KEY) === 'agdr' ? <Layout title="Quick Start"><section class="page"><p class="eyebrow">{agdrVersionBanner}</p><h1>Create your first AgDR in five minutes.</h1><p class="lede">Copy the template, record one consequential technical decision, and validate it against the published schema.</p><div class="card-grid"><article class="card"><h2>Zero dependency</h2><p>Copy <code>agdr-template.md</code>, fill the frontmatter and decision body, then run the repository validator.</p></article><article class="card"><h2>Agent integrations</h2><p>AgDR has integration guidance for Claude Code, Codex, Cursor, Copilot, Windsurf and generic agent prompts.</p></article></div><a class="button" href="https://github.com/me2resh/agent-decision-record/blob/main/agdr-template.md">Use the template</a></section></Layout> : <Layout title="Quick Start"><section class="page"><p class="eyebrow">ORBIT v0.1 · Draft</p><h1>Start with one outcome.</h1><pre class="code">{example}</pre><h2>Observe, reconcile, execute</h2><p>Observe current project state. Reconcile the plan against that state. Generate one bounded slice. Execute through the provider of your choice. Repeat.</p></section></Layout>}
