---
import Layout from '../layouts/StandardLayout.astro';
import { fieldRows, type ResourceDefinition } from '../data/orbit/resources';
import { sites } from '../lib/site';
const resource = Astro.props.resource as ResourceDefinition;
const rows = fieldRows(resource.schema);
const completeExample = resource.examples[1];
---
<Layout title={`${resource.displayName} resource`}><section class="page wide"><p class="pathbar">~/orbit/schemas/{resource.key}</p><p class="eyebrow">{resource.canonicalName} · ORBIT v0.1</p><h1>{resource.displayName}</h1><p class="type-label resource-canonical">{resource.canonicalName}</p><p class="lede">{resource.description}</p><div class="actions"><a class="button" href={resource.schemaPath}>View raw JSON Schema ↗</a><button class="button quiet copy-schema-url" type="button" data-schema-url={resource.schemaPath}>Copy schema URL</button><a class="button quiet" href={`/examples/${resource.key}/${completeExample.slug}`}>View examples →</a><a class="text-link" href={`${sites.orbit.sourceRepo}/blob/main/${resource.orbitSpecPath}`}>View source ↗</a></div>

<section class="editorial" id="overview"><h2 class="section-label">OVERVIEW</h2><p>{resource.purpose}</p><p class="resource-meta"><b>Canonical type</b> <code>{resource.canonicalName}</code><br /><b>References</b> {resource.references}</p></section>

<section class="editorial" id="structure"><h2 class="section-label">STRUCTURE</h2><p>The raw JSON Schema is the machine contract for this resource. The field reference below is derived from that schema.</p><pre class="code boundary-code">{JSON.stringify(resource.schema, null, 2)}</pre></section>

<section class="editorial" id="field-reference"><h2 class="section-label">FIELD REFERENCE</h2><div class="table-wrap"><table class="small-table field-table"><thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Meaning</th><th>Constraints</th></tr></thead><tbody>{rows.map(row => <tr><td><code>{row.field}</code></td><td>{row.type}</td><td>{row.required}</td><td>{row.meaning}</td><td>{row.constraints || '—'}</td></tr>)}</tbody></table></div></section>

<section class="editorial" id="relationships"><h2 class="section-label">RELATIONSHIPS</h2><div class="table-wrap"><table class="small-table"><thead><tr><th>Resource</th><th>Reference</th><th>Meaning</th></tr></thead><tbody>{resource.relationships.map(relationship => <tr><td><b>{relationship.name}</b></td><td><code>{relationship.reference}</code></td><td>{relationship.meaning}</td></tr>)}</tbody></table></div></section>

<section class="editorial" id="invariants"><h2 class="section-label">INVARIANTS</h2><p>JSON Schema validates structure. These semantic rules explain what a structurally valid {resource.canonicalName} must mean in the ORBIT model.</p><ul class="invariant-list">{resource.invariants.map(invariant => <li>{invariant}</li>)}</ul></section>

<section class="editorial" id="examples"><h2 class="section-label">EXAMPLES</h2><div class="resource-grid example-resource-grid">{resource.examples.map(item => <article class="resource-card"><p class="type-label">{resource.canonicalName}</p><h3>{item.label}</h3><p>Schema-valid JSON for the {resource.displayName} resource.</p><div class="resource-actions"><a href={`/examples/${resource.key}/${item.slug}`}>Open example →</a><a href={`/examples/${resource.key}/${item.slug}.json`}>Raw JSON ↗</a></div></article>)}</div></section>

<section class="editorial" id="raw-schema"><h2 class="section-label">RAW SCHEMA</h2><div class="guide-note"><p>The canonical machine-readable contract is available at <a href={resource.schemaPath}>{resource.schemaPath}</a>.</p><p>Use it for tooling, CI validation, and agent integrations. The human guide explains semantics; the schema defines structural conformance.</p></div></section>

<section class="editorial" id="related-resources"><h2 class="section-label">RELATED RESOURCES</h2><div class="resource-actions related-links">{resource.related.map(item => <a href={item.href}>{item.label} →</a>)}</div></section>
</section></Layout>
<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-schema-url').forEach(button => {
    button.addEventListener('click', async () => {
      const path = button.dataset.schemaUrl;
      if (!path) return;
      await navigator.clipboard.writeText(new URL(path, window.location.origin).href);
      const original = button.textContent;
      button.textContent = 'Copied';
      window.setTimeout(() => { button.textContent = original; }, 1400);
    });
  });
</script>
