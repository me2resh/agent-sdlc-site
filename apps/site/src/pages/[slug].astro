---
import Layout from '../layouts/StandardLayout.astro';
import { currentSite } from '../lib/site';
import OrbitSchemaIndex from '../components/OrbitSchemaIndex.astro';
const siteKey = currentSite(import.meta.env.PUBLIC_SITE_KEY);
type Page = { eyebrow: string; title: string; intro: string; sections: [string, string][] };
export const pages: Record<string, Page> = {
  governance: { eyebrow: 'Agent SDLC governance', title: 'Developed openly and versioned clearly.', intro: 'Agent SDLC specifications are developed through version-controlled specifications, schemas, issues, and pull requests.', sections: [['Propose a change','<a href="https://github.com/me2resh/agent-sdlc-site/issues/new">Open an issue</a> with the problem, proposed behaviour, and affected specification.'],['Report ambiguity','Describe conflicting readings and link to the relevant normative section.'],['Publication','Changes are proposed publicly and published as versioned specification releases.']] },
  contribute: { eyebrow: 'Contribute', title: 'Improve the specifications with evidence.', intro: 'Contributions can improve wording, schemas, examples, implementations, and interoperability.', sections: [['Specification changes','<a href="https://github.com/me2resh/agent-sdlc-site/issues/new">Propose a focused change</a> in the relevant repository.'],['Examples','Add examples that validate against the published schema.'],['Implementations','Register an implementation with a link and a clear support statement.']] },
  implementations: { eyebrow: 'Implementations', title: 'Specifications become useful through implementations.', intro: 'Implementation listings use conservative language and describe what is known.', sections: [['ApexYard','Early implementation of planning and reconciliation artefacts.'],['Register an implementation','Open a contribution with the repository, supported version, and tested capabilities.']] },
  schemas: { eyebrow: 'ORBIT schemas · v0.1 Draft', title: 'Machine-readable contracts.', intro: 'These draft schemas define portable artefact shape. Each file has a stable canonical URL and remains subject to change before 1.0.', sections: [['Plan','Durable intent, outcomes, criteria, scope, constraints, and planning knowledge. <a href="/schema/orbit-plan.json">View schema</a>'],['Project Snapshot','Point-in-time repository state used for observation. <a href="/schema/project-snapshot.json">View schema</a>'],['Reconciliation','Structured comparison between plan and current reality. <a href="/schema/reconciliation.json">View schema</a>'],['Execution Slice','One bounded software change with repository provenance. <a href="/schema/execution-slice.json">View schema</a>']] },
  reconciliation: { eyebrow: 'ORBIT reconciliation', title: 'Compare intent with current reality.', intro: 'A reconciler observes the project, assesses criteria by stable ID, records evidence, and explains the next justified action.', sections: [['Observe','Record repository and project facts with traceable evidence.'],['Assess','Update criterion and assumption assessments without rewriting canonical plan wording.'],['Derive','Generate one execution slice when the evidence supports it.']] },
  'execution-slices': { eyebrow: 'ORBIT execution slices', title: 'Materialise only the next bounded change.', intro: 'An execution slice describes software work. Provider-specific issue, branch, and run mechanics stay outside the portable artefact.', sections: [['Scope','State what the slice includes and excludes.'],['Provenance','Record the plan revision, reconciliation ID, and repository commits used.'],['Handoff','An executor translates the approved slice into its own workflow.']] },
  examples: { eyebrow: 'ORBIT examples · v0.1 Draft', title: 'Readable resources that validate.', intro: 'Each example is available as a human-readable guide and as raw JSON for tooling.', sections: [['Plan','<a href="/examples/plan/minimal">Minimal Plan</a> · <a href="/examples/plan/customer-sso">Complete Plan</a>'],['ProjectSnapshot','<a href="/examples/project-snapshot/minimal">Minimal ProjectSnapshot</a> · <a href="/examples/project-snapshot/customer-platform">Complete ProjectSnapshot</a>'],['Reconciliation','<a href="/examples/reconciliation/minimal">Minimal Reconciliation</a> · <a href="/examples/reconciliation/partial-verification">Complete Reconciliation</a>'],['ExecutionSlice','<a href="/examples/execution-slice/minimal">Minimal ExecutionSlice</a> · <a href="/examples/execution-slice/customer-sso">Complete ExecutionSlice</a>']] },
  conformance: { eyebrow: 'Conformance', title: 'Define what each role produces or consumes.', intro: 'Conformance stays independent of any coding agent, issue tracker, branch strategy, or CI provider.', sections: [['Producer','Produces valid artefacts for the relevant specification.'],['Observer','Produces a project-state snapshot.'],['Reconciler','Compares intent with reality and produces a conforming result.'],['Executor','Consumes an execution slice and applies provider-specific execution.']] },
  changelog: { eyebrow: 'Changelog', title: 'Follow specification changes.', intro: 'Version history records published changes and their status.', sections: [['v0.1','Draft specification. Breaking changes may occur before 1.0.']] },
  schema: { eyebrow: 'AgDR 1.2.0 schema', title: 'Validate Agent Decision Records.', intro: 'The published schema is copied from the normative repository source and is available as machine-readable JSON.', sections: [['Raw schema','Download the <a href="/schema/agdr.schema.json">AgDR JSON Schema</a>.'],['Normative source','The agent-decision-record repository remains the source of truth.'],['Validation','Examples must validate against the published schema in CI.']] },
  integrations: { eyebrow: 'AgDR integrations', title: 'Use AgDR without a required storage system.', intro: 'Consumers can read valid records without adopting a vendor-specific workflow.', sections: [['Storage','Store records with the repository or document system that fits the project.'],['Interoperability','Optional typed relationships can connect a decision to another artefact.']] },
  'related-standards': { eyebrow: 'Related standards', title: 'Independent standards can describe different layers.', intro: 'AgDR records one consequential agent decision. A related standard describes multi-agent deliberation and adjudication.', sections: [['External deliberation standards','Independent multi-agent standards can use their own governance and type names.'],['Interoperability','External standards may participate through the optional relationship profile.']] }
};
export function getStaticPaths(){
  const routesBySite: Record<string, string[]> = {
    agentsdlc: ['governance', 'contribute', 'implementations'],
    orbit: ['schemas', 'reconciliation', 'execution-slices', 'examples', 'conformance', 'changelog'],
    agdr: ['schema', 'examples', 'integrations', 'conformance', 'related-standards', 'changelog']
  };
  return (routesBySite[currentSite(import.meta.env.PUBLIC_SITE_KEY)] ?? []).map(slug => ({ params: { slug }, props: { page: pages[slug] } }));
}
const { page } = Astro.props;
---
{siteKey === 'orbit' && Astro.params.slug === 'schemas' ? <OrbitSchemaIndex /> : siteKey === 'agdr' && Astro.params.slug === 'conformance' ? <Layout title="Conformance"><section class="page"><p class="eyebrow">AgDR 1.2.0 · Published</p><h1>Produce and consume valid decision records.</h1><p class="lede">AgDR conformance does not require a specific storage system or agent.</p><div class="card-grid"><article class="card"><h2>AgDR Producer</h2><p>Creates records that conform to the published schema and specification.</p></article><article class="card"><h2>AgDR Validator</h2><p>Validates machine-readable frontmatter and body structure.</p></article><article class="card"><h2>AgDR Consumer</h2><p>Reads valid AgDRs without requiring vendor-specific extensions.</p></article></div></section></Layout> : siteKey === 'agdr' && Astro.params.slug === 'examples' ? <Layout title="Examples"><section class="page"><p class="eyebrow">AgDR examples</p><h1>Consequential decisions, preserved.</h1><p class="lede">These examples come from the normative repository and show the range of decisions an agent can record.</p><div class="card-grid"><article class="card"><h2>Authentication</h2><p>Choosing an authentication provider.</p></article><article class="card"><h2>Database</h2><p>Choosing workspace-partitioned DynamoDB keys.</p></article><article class="card"><h2>Migration</h2><p>Choosing a copy-on-login, script or dual-read migration.</p></article><article class="card"><h2>Release workflow</h2><p>Choosing a GitHub Actions release workflow.</p></article></div><a class="button" href="https://github.com/me2resh/agent-decision-record/tree/main/examples">View all examples</a></section></Layout> : <Layout title={page.title}><section class="page"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lede">{page.intro}</p><div class="card-grid">{page.sections.map(([heading, text]) => <article class="card"><h2>{heading}</h2><p set:html={text}></p></article>)}</div></section></Layout>}
