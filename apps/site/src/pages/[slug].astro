---
import Layout from '../layouts/StandardLayout.astro';
type Page = { eyebrow: string; title: string; intro: string; sections: [string, string][] };
export const pages: Record<string, Page> = {
  governance: { eyebrow: 'Agent SDLC governance', title: 'Developed openly and versioned clearly.', intro: 'Agent SDLC specifications are developed through version-controlled specifications, schemas, issues, and pull requests.', sections: [['Propose a change','Open an issue with the problem, the proposed behaviour, and the affected specification.'],['Report ambiguity','Describe the conflicting readings and link to the relevant normative section.'],['Publication','Changes are proposed publicly and published as versioned specification releases.']] },
  contribute: { eyebrow: 'Contribute', title: 'Improve the specifications with evidence.', intro: 'Contributions can improve wording, schemas, examples, implementations, and interoperability.', sections: [['Specification changes','Propose a focused change in the relevant repository.'],['Examples','Add examples that validate against the published schema.'],['Implementations','Register an implementation with a link and a clear support statement.']] },
  implementations: { eyebrow: 'Implementations', title: 'Specifications become useful through implementations.', intro: 'Implementation listings use conservative language and describe what is known.', sections: [['ApexYard','Early implementation of planning and reconciliation artefacts.'],['Register an implementation','Open a contribution with the repository, supported version, and tested capabilities.']] },
  schemas: { eyebrow: 'ORBIT schemas · v0.1 Draft', title: 'Machine-readable contracts.', intro: 'Schema files define portable artefact shape. The published files remain the source for validation.', sections: [['Plan','Durable intent, outcomes, criteria, scope, constraints, and planning knowledge.'],['Project Snapshot','Point-in-time repository state used for observation.'],['Reconciliation','Structured comparison between plan and current reality.'],['Execution Slice','One bounded software change with repository provenance.']] },
  reconciliation: { eyebrow: 'ORBIT reconciliation', title: 'Compare intent with current reality.', intro: 'A reconciler observes the project, assesses criteria by stable ID, records evidence, and explains the next justified action.', sections: [['Observe','Record repository and project facts with traceable evidence.'],['Assess','Update criterion and assumption assessments without rewriting canonical plan wording.'],['Derive','Generate one execution slice when the evidence supports it.']] },
  'execution-slices': { eyebrow: 'ORBIT execution slices', title: 'Materialise only the next bounded change.', intro: 'An execution slice describes software work. Provider-specific issue, branch, and run mechanics stay outside the portable artefact.', sections: [['Scope','State what the slice includes and excludes.'],['Provenance','Record the plan revision, reconciliation ID, and repository commits used.'],['Handoff','An executor translates the approved slice into its own workflow.']] },
  examples: { eyebrow: 'Examples', title: 'Readable artefacts for implementation.', intro: 'Examples are informative until they are validated against a published schema.', sections: [['ORBIT','Plan, snapshot, reconciliation, and execution-slice examples will be validated in CI.'],['AgDR','Examples are sourced from the agent-decision-record repository.']] },
  conformance: { eyebrow: 'Conformance', title: 'Define what each role produces or consumes.', intro: 'Conformance stays independent of any coding agent, issue tracker, branch strategy, or CI provider.', sections: [['Producer','Produces valid artefacts for the relevant specification.'],['Observer','Produces a project-state snapshot.'],['Reconciler','Compares intent with reality and produces a conforming result.'],['Executor','Consumes an execution slice and applies provider-specific execution.']] },
  changelog: { eyebrow: 'Changelog', title: 'Follow specification changes.', intro: 'Version history records published changes and their status.', sections: [['v0.1','Draft specification. Breaking changes may occur before 1.0.']] },
  schema: { eyebrow: 'AgDR schema', title: 'Validate Agent Decision Records.', intro: 'The published schema route will be generated from the normative repository source.', sections: [['Normative source','The agent-decision-record repository remains the source of truth.'],['Validation','Examples must validate against the published schema in CI.']] },
  integrations: { eyebrow: 'AgDR integrations', title: 'Use AgDR without a required storage system.', intro: 'Consumers can read valid records without adopting a vendor-specific workflow.', sections: [['Storage','Store records with the repository or document system that fits the project.'],['Interoperability','Optional typed relationships can connect a decision to another artefact.']] },
  'related-standards': { eyebrow: 'Related standards', title: 'Independent standards can describe different layers.', intro: 'AgDR records one consequential agent decision. AIDR describes multi-agent deliberation and adjudication.', sections: [['AIDR','See https://aidr.work/ for the related ecosystem standard.'],['Interoperability','See the discussion at https://github.com/me2resh/agent-decision-record/issues/8.']] }
};
export function getStaticPaths(){ return Object.keys(pages).map(slug => ({ params: { slug }, props: { page: pages[slug] } })); }
const { page } = Astro.props;
---
<Layout title={page.title}><section class="page"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lede">{page.intro}</p><div class="card-grid">{page.sections.map(([heading, text]) => <article class="card"><h2>{heading}</h2><p>{text}</p></article>)}</div></section></Layout>
