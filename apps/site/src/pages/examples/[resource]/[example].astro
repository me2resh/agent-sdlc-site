---
import OrbitExamplePage from '../../../components/OrbitExamplePage.astro';
import { currentSite } from '../../../lib/site';
import { hasRoute } from '../../../lib/routes';
import { resources } from '../../../data/orbit/resources';

// The route registry (src/lib/routes.ts) decides which sites build these pages (#31).
export function getStaticPaths() {
  const site = currentSite(import.meta.env.PUBLIC_SITE_KEY);
  return resources.flatMap(resource => resource.examples
    .filter(example => hasRoute(site, `/examples/${resource.key}/${example.slug}`))
    .map(example => ({ params: { resource: resource.key, example: example.slug }, props: { resource, example } })));
}

const resource = Astro.props.resource;
const example = Astro.props.example;
if (!resource || !example) throw new Error(`Unknown ORBIT example: ${Astro.params.resource}/${Astro.params.example}`);
---
<OrbitExamplePage resource={resource} example={example} />
