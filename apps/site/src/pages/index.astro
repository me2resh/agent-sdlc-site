---
import Layout from '../layouts/StandardLayout.astro';
import { currentSite, sites } from '../lib/site';
const key = currentSite(import.meta.env.PUBLIC_SITE_KEY); const site = sites[key];
const copy = key === 'orbit' ? { title: 'Keep execution aligned with durable outcomes.', intro: 'ORBIT is a Planning and Reconciliation Specification for expressing durable software intent and deriving one bounded execution slice from current reality.', link: '/specification', label: 'Read the specification' } : key === 'agdr' ? { title: 'Record what an agent decided and why.', intro: 'AgDR preserves consequential technical decisions and their rationale beyond the session that created the code.', link: '/specification', label: 'Read the specification' } : { title: 'Open artefacts for agentic software engineering.', intro: site.description, link: '/standards', label: 'Explore the standards' };
---
<Layout><section class="page"><p class="eyebrow">{site.kicker}</p><h1>{copy.title}</h1><p class="lede">{copy.intro}</p><div class="actions"><a class="button" href={copy.link}>{copy.label}</a><a class="button quiet" href="https://github.com/me2resh/agent-sdlc-site">View source</a></div><div class="card-grid"><article class="card"><h2>Portable</h2><p>Human-readable and machine-readable artefacts can move across agents, repositories, and tools.</p></article><article class="card"><h2>Versioned</h2><p>Every specification shows its version and publication status.</p></article><article class="card"><h2>Implementation-neutral</h2><p>Tools implement the artefacts. The specifications do not require one provider or workflow.</p></article></div></section></Layout>
