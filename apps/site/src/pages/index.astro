---
const host = Astro.url.hostname;
const site = host.includes('agdr') ? {name:'AgDR', kicker:'Agent Decision Record', headline:'Record what an agent decided and why.', description:'A durable record of a consequential technical decision made by an AI agent.', key:'agdr'} : host.includes('orbit') ? {name:'ORBIT', kicker:'Planning and Reconciliation Specification', headline:'Keep execution aligned with durable outcomes.', description:'A portable specification for expressing software intent and reconciling it against current reality before work is materialised.', key:'orbit'} : {name:'Agent SDLC', kicker:'Open artefacts for agentic software engineering', headline:'Portable standards for agentic software engineering.', description:'A family of open specifications for planning, execution context and decision provenance across agents, humans, repositories and development tools.', key:'agentsdlc'};
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{site.name} — {site.kicker}</title><meta name="description" content={site.description} /><link rel="canonical" href={Astro.url.href} /></head><body><header><a href="/" class="brand">{site.name}</a><nav><a href="#overview">Overview</a><a href="#specification">Specification</a><a href="#schemas">Schemas</a><a href="https://github.com/me2resh/agent-sdlc-site">GitHub</a></nav></header><main><section class="hero"><p class="eyebrow">{site.kicker}</p><h1>{site.headline}</h1><p class="lede">{site.description}</p><div class="actions"><a class="button" href="#specification">Read the specification</a><a class="button quiet" href="#schemas">View schemas</a></div></section><section id="overview" class="grid"><article><h2>Open and implementation-neutral</h2><p>These artefacts can move across agents, humans, repositories, issue trackers and toolchains.</p></article><article><h2>Portable and versioned</h2><p>Human-readable documents and machine-readable schemas preserve intent beyond a single session or provider.</p></article><article><h2>Designed to interoperate</h2><p>Stable identifiers, typed relationships and namespaced extensions keep independent standards composable.</p></article></section><section id="specification" class="content"><p class="eyebrow">{site.name}</p><h2>{site.key === 'orbit' ? 'A Plan is not a backlog.' : site.key === 'agdr' ? 'The session disappears. The decision should not.' : 'Open artefacts for agentic software engineering.'}</h2><p>{site.key === 'orbit' ? 'ORBIT keeps durable outcomes stable while deriving one bounded execution slice from current reality.' : site.key === 'agdr' ? 'AgDR preserves the rationale for consequential technical decisions after the agent session ends.' : 'Agent SDLC contains ORBIT for planning and reconciliation and AgDR for decision provenance.'}</p></section><section id="schemas" class="schema"><h2>Specification status</h2><p><strong>{site.name} v0.1</strong> · Draft</p><p>Normative content will be generated from version-controlled specification sources.</p></section></main><footer><span>Part of Agent SDLC</span><a href="https://agentsdlc.ai">agentsdlc.ai</a><a href="https://github.com/me2resh/agent-sdlc-site">View source</a></footer></body></html>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#17202a;background:#f7f8fa;line-height:1.6}body{margin:0}header,main,footer{max-width:1120px;margin:auto;padding:1.25rem 1.5rem}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #d8dee6}.brand{font-weight:700;color:#17202a;text-decoration:none}nav{display:flex;gap:1rem;font-size:.9rem}a{color:#174ea6}nav a,footer a{text-decoration:none}.hero{padding:7rem 0 5rem;max-width:800px}.eyebrow{font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:#174ea6;font-weight:700}.hero h1{font-size:clamp(2.5rem,7vw,5rem);line-height:1.05;letter-spacing:-.05em;margin:.5rem 0 1.5rem}.lede{font-size:1.25rem;color:#5e6b78;max-width:680px}.actions{display:flex;gap:.75rem;margin-top:2rem}.button{background:#174ea6;color:white;padding:.7rem 1rem;border-radius:.35rem;text-decoration:none}.button.quiet{background:white;color:#174ea6;border:1px solid #d8dee6}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.grid article,.content,.schema{background:#fff;border:1px solid #d8dee6;border-radius:.7rem;padding:1.5rem}.content{margin:5rem 0 1rem}.schema{margin:1rem 0 5rem}footer{display:flex;gap:1rem;border-top:1px solid #d8dee6;color:#5e6b78;font-size:.9rem}@media(max-width:720px){header,footer{display:block}nav{margin-top:1rem;flex-wrap:wrap}.hero{padding:4rem 0 3rem}.grid{grid-template-columns:1fr}footer>*{display:inline-block;margin-right:.8rem}}
@media(prefers-color-scheme:dark){:root{color:#e8eef5;background:#111820}.brand{color:#e8eef5}.grid article,.content,.schema,.button.quiet{background:#17202a;border-color:#3a4653}.lede,footer{color:#aebdca}header,footer{border-color:#3a4653}.button.quiet{color:#b8d0ff}}
</style>
