---
import { currentSite, sites } from '../lib/site';
const key = currentSite(import.meta.env.PUBLIC_SITE_KEY);
const site = sites[key];
const title = Astro.props.title ? `${Astro.props.title} — ${site.name}` : `${site.name} — ${site.kicker}`;
const nav = key === 'orbit' ? [['Concepts','/concepts'],['Quick Start','/quick-start'],['Specification','/specification'],['Schemas','/schemas'],['Conformance','/conformance']] : key === 'agdr' ? [['Quick Start','/quick-start'],['Specification','/specification'],['Schema','/schema'],['Examples','/examples'],['Conformance','/conformance']] : [['Standards','/standards'],['Interoperability','/interoperability'],['Governance','/governance'],['Contribute','/contribute']];
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={site.description} /><link rel="canonical" href={`${site.canonicalUrl}${Astro.url.pathname}`} /></head><body><header><a href="/" class="brand">{site.name}</a><nav>{nav.map(([label,href]) => <a href={href}>{label}</a>)}<a href="https://github.com/me2resh/agent-sdlc-site">GitHub</a></nav></header><main><slot /></main><footer><span>Part of Agent SDLC</span><a href="https://agentsdlc.ai">agentsdlc.ai</a><a href="https://github.com/me2resh/agent-sdlc-site">View source</a></footer></body></html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#17202a;background:#f7f8fa;line-height:1.6}body{margin:0}header,main,footer{max-width:1120px;margin:auto;padding:1.25rem 1.5rem}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #d8dee6}.brand{font-weight:700;color:#17202a;text-decoration:none}nav{display:flex;gap:1rem;font-size:.9rem}a{color:#174ea6}nav a,footer a{text-decoration:none}.page{padding:4rem 0 5rem;max-width:820px}.eyebrow{font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:#174ea6;font-weight:700}.page h1{font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.05;letter-spacing:-.05em;margin:.5rem 0 1rem}.page h2{margin-top:3rem;line-height:1.2}.lede{font-size:1.2rem;color:#5e6b78}.card-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:2rem}.card,.callout{background:#fff;border:1px solid #d8dee6;border-radius:.7rem;padding:1.25rem}.callout{border-top:2px solid #7d8996;border-left:1px solid #d8dee6;border-radius:.3rem;margin:1.5rem 0}.code{font: .9rem/1.6 "SFMono-Regular",Consolas,monospace;white-space:pre-wrap;background:#17202a;color:#e8eef5;padding:1.25rem;border-radius:.5rem;overflow:auto}footer{display:flex;gap:1rem;border-top:1px solid #d8dee6;color:#5e6b78;font-size:.9rem}footer a{display:inline-block}@media(max-width:720px){header,footer{display:block}nav{margin-top:1rem;flex-wrap:wrap}.card-grid{grid-template-columns:1fr}}
@media(prefers-color-scheme:dark){:root{color:#e8eef5;background:#111820}.brand{color:#e8eef5}.card,.callout{background:#17202a;border-color:#3a4653}.callout{border-top-color:#98a5b3}.lede,footer{color:#aebdca}header,footer{border-color:#3a4653}}
</style>
