---
import { currentSite, sites } from '../lib/site';
import { agdrVersionBanner } from '../lib/agdr-changelog';
import '@agent-sdlc/design-system/tokens.css';
const key = currentSite(import.meta.env.PUBLIC_SITE_KEY);
const site = sites[key];
const version = key === 'agdr' ? agdrVersionBanner : key === 'orbit' ? 'ORBIT v0.1 · Draft' : 'Agent SDLC · Early ecosystem';
const title = Astro.props.title ? `${Astro.props.title} — ${site.name}` : `${site.name} — ${site.kicker}`;
const footerLabel = key === 'agentsdlc' ? 'Agent SDLC' : `${site.name} · Agent SDLC`;
const footerContributeHref = key === 'orbit' || key === 'agentsdlc' ? '/contribute' : null;
const nav = key === 'orbit' ? [['Concepts','/concepts'],['Quick Start','/quick-start'],['Specification','/specification'],['Schemas','/schemas'],['Reconciliation','/reconciliation'],['Execution Slices','/execution-slices'],['Implementation','/adopter-guide'],['Conformance','/conformance'],['Changelog','/changelog'],['Contribute','/contribute']] : key === 'agdr' ? [['Quick Start','/quick-start'],['Specification','/specification'],['Schema','/schema'],['Examples','/examples'],['Integrations','/integrations'],['Conformance','/conformance'],['Related standards','/related-standards']] : [['ORBIT','https://orbitspec.dev'],['AgDR','https://agdr.dev'],['Interoperability','/interoperability'],['About','/governance']];
// Per-standard identity mark (Option A — "RFC Register"). Colored by
// currentColor, so it inherits the shared --accent property that
// tokens.css maps per `${key}-site` body class.
const marks: Record<typeof key, string> = {
  agentsdlc: '<svg class="brand-mark" viewBox="0 0 32 32" width="20" height="20" aria-hidden="true"><circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="16" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>',
  orbit: '<svg class="brand-mark" viewBox="0 0 32 32" width="20" height="20" aria-hidden="true"><ellipse cx="16" cy="16" rx="13" ry="7" fill="none" stroke="currentColor" stroke-width="2" transform="rotate(-18 16 16)"/><circle cx="26.5" cy="9" r="2.1" fill="currentColor"/></svg>',
  agdr: '<svg class="brand-mark" viewBox="0 0 32 32" width="20" height="20" aria-hidden="true"><path d="M4 16 L13 6 H27 V26 H13 Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="18" cy="16" r="2" fill="currentColor"/></svg>'
};
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={site.description} /><meta property="og:title" content={title} /><meta property="og:description" content={site.description} /><meta property="og:url" content={`${site.canonicalUrl}${Astro.url.pathname}`} /><link rel="canonical" href={`${site.canonicalUrl}${Astro.url.pathname}`} />
<script is:inline>
  /* Set the theme attribute before first paint, so there is no flash of
     the wrong theme. With no saved preference, follow the OS setting. */
  (function () {
    var root = document.documentElement;
    var saved = null;
    /* 'orbit-theme' is the key the sites used before #17. Move a saved
       value to the new key once, so a returning visitor keeps the theme. */
    try {
      saved = window.localStorage.getItem('theme');
      var legacy = window.localStorage.getItem('orbit-theme');
      if (legacy !== null) {
        if (saved === null && (legacy === 'light' || legacy === 'dark')) {
          saved = legacy;
          window.localStorage.setItem('theme', legacy);
        }
        window.localStorage.removeItem('orbit-theme');
      }
    } catch (err) { saved = null; }
    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = saved === 'light' || saved === 'dark' ? saved : (prefersDark ? 'dark' : 'light');
  })();
</script>
</head><body class={`${key}-site`}><header><div class="header-top"><div class="brand-line"><a href={key === 'agentsdlc' ? '/' : 'https://agentsdlc.ai'} class="brand" set:html={`${marks[key]}<span class="brand-name">${key === 'agentsdlc' ? '~/agent-sdlc' : site.name}</span>`} /><span class="version">{version}</span></div><div class="header-actions">{key !== 'agentsdlc' && <a class="utility" href="https://agentsdlc.ai">Agent SDLC ↗</a>}<a class="utility" href={site.sourceRepo}>GitHub ↗</a><button class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme">☼</button></div></div><nav class={key === 'orbit' ? 'primary-nav orbit-nav' : 'primary-nav'}>{key === 'orbit' ? <><div><span>Learn</span><a href="/concepts">Concepts</a></div><div><span>Reference</span><a href="/specification">Specification</a><a href="/schemas">Schemas</a><a href="/reconciliation">Reconciliation</a><a href="/execution-slices">Execution slices</a></div><div><span>Adopt</span><a href="/adopter-guide">Adopter guide</a><a href="/conformance">Conformance</a></div><div><span>Project</span><a href="/changelog">Changelog</a><a href="/contribute">Contribute</a></div></> : nav.map(([label,href]) => <a href={href}>{label}</a>)}</nav></header><main><slot /></main><footer><span>{footerLabel}</span><a href="https://agentsdlc.ai">About Agent SDLC</a><a href={site.sourceRepo}>Source</a>{footerContributeHref && <a href={footerContributeHref}>Contribute</a>}<span class="maintained-by">Maintained by ApexYard</span></footer></body></html>
<script is:inline>
  const root = document.documentElement;
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { window.localStorage.setItem('theme', next); } catch (err) { /* no-op: private mode / storage disabled */ }
  });
  const adoptLink = document.querySelector('.orbit-home .button[href="/quick-start"]');
  if (adoptLink) {
    adoptLink.setAttribute('href', '/adopter-guide');
    adoptLink.textContent = 'Start adopting ORBIT';
  }
  const guideLink = document.querySelector('.orbit-home-card[href="/adopter-guide"] strong');
  if (guideLink) guideLink.textContent = 'Open adopter guide →';
</script>
<style is:global>
/* ============================================================
   Standards sites — shared stylesheet.
   Every color below is a custom property from
   @agent-sdlc/design-system/tokens.css. No literal color value
   belongs in this file — see scripts/validate-design-tokens.mjs.
   ============================================================ */

/* ---- base ---- */
:root { font-family: var(--font-mono); line-height: var(--leading-body); }
body { margin: 0; font-family: var(--font-mono); }
h1, h2, h3, .brand-name { font-family: var(--font-display); }
h1, h2, h3 { font-weight: 700; }
a { color: var(--accent); }
nav a, footer a { text-decoration: none; }

/* ---- header ---- */
header, main, footer { max-width: 1120px; margin: auto; padding: 1.25rem 1.5rem; }
header, footer { border-color: var(--rule); }
header { border-bottom: 1px solid var(--rule); }
.header-top { display: flex; gap: 1rem; justify-content: space-between; align-items: center; }
.brand-line { display: flex; gap: 1rem; align-items: baseline; }
.header-actions { display: flex; gap: 1rem; align-items: center; }
.primary-nav { display: flex; gap: 1.1rem; padding-top: 1rem; font-size: .9rem; flex-wrap: wrap; }
.primary-nav a { white-space: nowrap; }
.brand { display: inline-flex; align-items: center; gap: .45rem; font-weight: 700; color: var(--text); text-decoration: none; }
.brand-mark { color: var(--accent); flex-shrink: 0; }
.version, .pathbar, .section-label, .meta { font: var(--text-small)/1.4 var(--font-mono); color: var(--muted); }
.version { font-size: .75rem; }
nav { display: flex; gap: 1rem; font-size: .9rem; }
.utility { font: .72rem var(--font-mono); text-decoration: none; white-space: nowrap; }
.maintained-by { color: var(--muted); font-size: .78rem; margin-left: auto; }

/* ---- page shell / type ---- */
.page { padding: 4rem 0 5rem; max-width: 900px; }
.page.wide { max-width: 1050px; }
.page h1 { font-size: var(--text-display); line-height: var(--leading-display); letter-spacing: -.03em; margin: .5rem 0 1rem; }
.page h2 { font-size: clamp(1.8rem, 4vw, 3rem); margin: .6rem 0 1rem; line-height: 1.12; letter-spacing: -.02em; }
.lede { font-size: 1.2rem; color: var(--muted); max-width: 700px; }
/* Labels are plain and muted: no uppercase, no letter-spacing, no accent
   color (agent-sdlc-site#17, rule 4). */
.eyebrow, .section-label { color: var(--muted); font-weight: 600; }
.section-label { margin: 0; }
.pathbar { margin: 0 0 2.5rem; color: var(--muted); }
.meta { color: var(--muted); }

/* ---- status pills ---- */
.status-row { display: flex; gap: .5rem; flex-wrap: wrap; margin: 1rem 0 1.5rem; }
.status { font: .72rem var(--font-mono); color: var(--accent); border: 1px solid var(--rule); border-radius: var(--radius-sm); padding: .35rem .55rem; }
.status.informative { color: var(--accent); border-color: var(--accent); }
.status.experimental, .status.neutral { color: var(--muted); border-color: var(--rule); }

/* ---- callout / guide-note — a full 1px outline, no tint, no colored
   left border (agent-sdlc-site#17, Option A rule 3) ---- */
.callout { padding: 1rem 1.2rem; border: 1px solid var(--accent); border-radius: var(--radius-md); background: var(--bg); color: var(--text); }
.guide-note { border: 1px solid var(--accent); border-radius: var(--radius-md); background: var(--bg); color: var(--text); padding: 1rem 1.25rem; margin: 1.5rem 0; }
.guide-note strong { color: var(--text); }
.guide-note p { margin: .4rem 0 0; }
.guide-note p + p { margin-top: .75rem; }

/* ---- toc / tables ---- */
.toc { display: flex; gap: .8rem; flex-wrap: wrap; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: .9rem 0; margin: 2rem 0; font-size: .82rem; }
.toc a { color: var(--muted); text-decoration: none; }
.table-wrap { overflow: auto; }
.table-wrap table { border-collapse: collapse; width: 100%; font-size: .9rem; }
.table-wrap th, .table-wrap td { text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); padding: .75rem; }
.small-table { font-size: .86rem; }
.small-table td:first-child, .small-table th:first-child { white-space: nowrap; }

/* ---- role grid / pull quotes — a left accent rule with no
   background tint; not the forbidden callout shape ---- */
.role-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.role-grid p, .contrast-row > *, .contrast p, .comparison p { border-top: 2px solid var(--accent); padding-top: .75rem; }

/* ---- misc index / vocabulary lists ---- */
.example-index { display: grid; grid-template-columns: repeat(2, 1fr); gap: .6rem; margin: 1.5rem 0; }
.example-index a { border: 1px solid var(--rule); padding: .7rem; text-decoration: none; background: var(--surface); color: var(--text); }
.code-actions { font: .72rem var(--font-mono); color: var(--accent); }
.vocabulary { display: flex; flex-wrap: wrap; gap: .6rem; }
.vocabulary code { border: 1px solid var(--rule); padding: .45rem .7rem; background: var(--surface); color: var(--text); }

/* ---- buttons / links ---- */
.actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin: 2rem 0 3rem; }
.button { display: inline-block; background: var(--accent); color: var(--bg); padding: .65rem 1rem; border-radius: var(--radius-sm); text-decoration: none; font-weight: 650; }
.button.quiet { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
.text-link { align-self: center; font: .78rem var(--font-mono); text-decoration: none; }

/* ---- editorial / standards grid (home page) ---- */
.editorial { border-top: 1px solid var(--rule); padding: 2.5rem 0; margin: 3rem 0; }
.standards-heading { margin-top: 1.5rem; }
.standards-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
.standard-name { font-size: clamp(2.2rem, 6vw, 4.5rem); line-height: 1; letter-spacing: -.04em; margin: 1.2rem 0 .4rem; font-weight: 700; color: var(--text); }
.standard { display: flex; flex-direction: column; min-height: 610px; }
.standard h2 { height: 4.4em; }
.standard > p:not(.section-label):not(.standard-name):not(.meta) { min-height: 5.1em; }
.standard > a { margin-top: auto; }
.standard > .meta:last-child { margin-top: .5rem; }

/* ---- surfaces: cards / boxed content ---- */
.artefact, .lifecycle, .card, .resource-card, .orbit-home-card, .adoption-records a, .handoff-node {
  border: 1px solid var(--rule);
  background: var(--surface);
  color: var(--text);
}
.artefact, .lifecycle { padding: 1.5rem; margin: 2rem 0; }
.card { padding: 1.25rem; border-radius: var(--radius-md); }
.card h2 { font-size: 1.35rem; margin: .1rem 0 .55rem; }
.card p { margin: 0; color: var(--muted); }
.card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0; }
.handoff-node { padding: 1rem; }
.handoff-node b { display: block; color: var(--accent); margin-bottom: .45rem; }
.handoff-node span { display: block; color: var(--muted); font-size: .88rem; }

/* ---- code / terminal / diagram nodes — one mono surface, theme-aware ---- */
.code, .terminal, .orbit-step, .stale-node {
  font: .88rem/1.55 var(--font-mono);
  white-space: pre-wrap;
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--rule);
  border-radius: var(--radius-sm);
  padding: 1.25rem;
  overflow: auto;
}
.orbit-step, .stale-node { padding: 1rem; }
.orbit-step { min-height: 8rem; }
.orbit-step b, .stale-node b { display: block; color: var(--muted); font: 600 .78rem var(--font-mono); margin-bottom: .45rem; }
.orbit-step p, .stale-node span { margin: 0; color: var(--muted); font-size: .9rem; }
.stale-warning { border-top: 2px solid var(--accent); }
.stale-warning b { color: var(--text); }
.artefact-grid { grid-template-columns: 1fr 1fr; }
.artefact-grid .code { min-height: 150px; }
.boundary-code { white-space: pre; overflow: auto; border: 1px solid var(--rule); border-top: 2px solid var(--accent); font-size: .82rem; }
.checklist { padding-left: 1.25rem; }
.checklist li { padding: .35rem 0; }
.checklist code { display: block; margin: .15rem 0 .2rem; color: var(--muted); font: .72rem var(--font-mono); }
.type-label { font: .72rem var(--font-mono); }

/* ---- split / contrast / rows ---- */
.split { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; border-top: 1px solid var(--rule); padding: 2.5rem 0; margin: 2.5rem 0; }
.contrast, .comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.contrast-rows { margin-top: 1rem; }
.contrast-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.contrast-row > * { padding: .75rem 0 1rem; margin: 0 0 1rem; }
.contrast-row:first-child > * { padding-bottom: .5rem; }
.rows p { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--rule); padding: .8rem 0; }
.rows span { color: var(--muted); }
.equation-list p { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--rule); padding: .8rem 0; margin: 0; }
.equation-list span { color: var(--muted); }

/* ---- stage / trust strip / loop-return ---- */
.stage { display: flex; gap: 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
.stage:last-child { border-bottom: 0; }
.stage b { font: .78rem var(--font-mono); color: var(--accent); min-width: 6rem; }
.stage span { color: var(--muted); }
.trust-strip { display: flex; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--rule); padding: 1.25rem 0; margin-top: 3rem; font: .72rem var(--font-mono); color: var(--muted); }
.trust-strip span { padding-right: 1rem; border-right: 1px solid var(--rule); }
.loop-return { display: flex; justify-content: flex-end; align-items: center; gap: .7rem; border-top: 1px solid var(--rule); padding: 1rem 0 0; margin-top: 1rem; color: var(--muted); font: .82rem var(--font-mono); }
.loop-return span:first-child { color: var(--accent); font-size: 1.5rem; }
.handoff-stack { max-width: 620px; margin: 1.5rem auto; }
.handoff-stack .handoff-node { text-align: center; }
.handoff-arrow { color: var(--accent); text-align: center; font-size: 1.5rem; line-height: 1.5; }
.stale-flow { display: flex; flex-direction: column; align-items: stretch; justify-content: center; min-height: 100%; padding-top: 2rem; }

/* ---- footer ---- */
footer { display: flex; gap: 1rem; align-items: baseline; flex-wrap: wrap; border-top: 1px solid var(--rule); color: var(--muted); font-size: .9rem; }
footer a { display: inline-block; }

/* ---- theme toggle ---- */
.theme-toggle { border: 1px solid var(--rule); background: transparent; color: var(--text); border-radius: 999px; width: 2rem; height: 2rem; padding: 0; cursor: pointer; font-size: 1.05rem; }
.theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* ---- resource cards ---- */
.resource-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
.resource-card { padding: 1.25rem; display: flex; flex-direction: column; min-height: 13rem; }
.resource-card h3 { font-size: 1.5rem; margin: .4rem 0 .7rem; color: var(--text); }
.resource-card p { margin: .35rem 0; color: var(--muted); }
.resource-card .type-label { color: var(--muted); }
.resource-meta { color: var(--muted); font-size: .88rem; }
.resource-actions { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: auto; padding-top: 1rem; font: .78rem var(--font-mono); }
.resource-actions a { text-decoration: none; }
.resource-canonical { color: var(--accent); margin-top: -.55rem; }
.resource-graph { margin: 1.5rem 0; }
.resource-relationship-grid { margin-top: 1rem; }
.field-table td:first-child { white-space: nowrap; }
.invariant-list { padding-left: 1.25rem; }
.invariant-list li { padding: .45rem 0; }
.copy-json { border: 0; font: inherit; cursor: pointer; }
.example-actions { align-items: center; }
.related-links { margin-top: 0; }
.resource-grid + .resource-grid { margin-top: 1rem; }

/* ---- adoption steps / records ---- */
.adoption-steps { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; padding: 0; list-style: none; counter-reset: step; }
.adoption-steps li { counter-increment: step; border-top: 1px solid var(--rule); padding: 1.1rem 0 1.2rem; display: grid; grid-template-columns: 2rem 1fr; gap: .5rem; }
.adoption-steps li::before { content: counter(step, decimal-leading-zero); font: .72rem var(--font-mono); color: var(--accent); }
.adoption-steps b { display: block; }
.adoption-steps span { grid-column: 2; color: var(--muted); }
.adoption-records { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
.adoption-records a { padding: .85rem; text-decoration: none; }
.adoption-records b, .adoption-records span { display: block; }
.adoption-records span { font-size: .85rem; color: var(--muted); margin-top: .2rem; }

/* ---- guide links (adopter guide) ---- */
.guide-links { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; background: var(--surface); border: 1px solid var(--rule); padding: 1rem; }
.guide-links a { display: block; padding: .8rem; text-decoration: none; border: 1px solid var(--rule); background: var(--bg); color: var(--text); }
.guide-links a:hover { border-color: var(--accent); }
.guide-links strong, .guide-links span { display: block; }
.guide-links span { font-size: .82rem; color: var(--muted); margin-top: .3rem; }

/* ---- interoperability diagram ---- */
.interop-diagram { display: flex; flex-direction: column; align-items: stretch; gap: .6rem; padding: 1.25rem; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-sm); }
.interop-node { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; padding: .8rem 1rem; background: var(--bg); border: 1px solid var(--rule); border-top: 2px solid var(--accent); }
.interop-node span { color: var(--muted); font: .72rem var(--font-mono); }
.interop-node strong { font-family: var(--font-display); font-size: 1.1rem; }
.interop-arrow { color: var(--accent); font: 1.25rem var(--font-mono); text-align: center; animation: interop-pulse 1.8s ease-in-out infinite; }
.interop-node:nth-of-type(3) { animation: interop-highlight 1.8s ease-in-out infinite; }
.interop-outputs { display: grid; grid-template-columns: auto 1fr auto 1fr; gap: .6rem; align-items: center; margin-top: .2rem; padding-left: 1rem; }
.interop-outputs .interop-arrow { text-align: left; }
@keyframes interop-pulse { 0%, 100% { opacity: .35; transform: translateY(-2px); } 50% { opacity: 1; transform: translateY(2px); } }
@keyframes interop-highlight { 0%, 100% { border-color: var(--rule); } 50% { border-color: var(--accent); } }
@media (prefers-reduced-motion: reduce) { .interop-arrow, .interop-node:nth-of-type(3) { animation: none; } }
@media (max-width: 560px) { .interop-node { display: block; } .interop-node strong { display: block; margin-top: .2rem; } .interop-outputs { grid-template-columns: auto 1fr; } .interop-outputs .interop-arrow:nth-of-type(2) { display: none; } }

/* ---- orbit flow / handoff diagrams ---- */
.orbit-flow { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr; align-items: stretch; gap: .65rem; margin: 1.5rem 0; }
.flow-arrow { display: flex; align-items: center; justify-content: center; color: var(--accent); font-size: 1.4rem; }
.orbit-handoff { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: stretch; gap: .65rem; margin: 1.5rem 0; }

/* ---- orbit nav / home ---- */
.orbit-nav { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding-top: 1.15rem; }
.orbit-nav div { display: flex; flex-wrap: wrap; gap: .35rem .8rem; align-items: baseline; }
.orbit-nav span { width: 100%; font: .72rem var(--font-mono); color: var(--muted); }
.orbit-nav a { font-size: .85rem; }
.orbit-nav > div { display: block; min-width: 0; }
.orbit-nav > div > span { display: block; margin-bottom: .35rem; }
.orbit-nav > div > a { display: inline-block; margin-right: .7rem; }
.orbit-site main { max-width: 1120px; margin: auto; padding: 0 1.5rem; }
.orbit-site .page { max-width: 920px; padding-top: 4.5rem; }
.orbit-site .page.wide { max-width: 1120px; }
.orbit-site .page h1 { max-width: 980px; font-size: clamp(2.8rem, 6vw, 4.8rem); }
.orbit-site .page .lede { font-size: 1.18rem; line-height: 1.65; }
.orbit-site .editorial { margin: 2.5rem 0; padding: 2rem 0; }
.orbit-site .card-grid { margin-top: 2rem; }
.orbit-site footer { align-items: center; flex-wrap: wrap; padding-top: 1.5rem; padding-bottom: 2rem; }
.orbit-site footer span:first-child { margin-right: auto; }
.orbit-site footer a { font: .78rem var(--font-mono); }
.orbit-home { padding: 3.4rem 0 5rem; }
.orbit-home .orbit-kicker { display: flex; gap: .55rem; align-items: center; font: .78rem var(--font-mono); color: var(--muted); }
.orbit-home h1 { max-width: 760px; margin: 1rem 0 1.2rem; font-size: clamp(3rem, 7vw, 5.8rem); }
.orbit-home .lede { max-width: 680px; font-size: 1.35rem; }
.orbit-home-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 3.5rem 0 2rem; }
.orbit-home-card { display: flex; flex-direction: column; min-height: 12rem; padding: 1.25rem; text-decoration: none; color: inherit; }
.orbit-home-card:hover { border-color: var(--accent); transform: translateY(-2px); }
.orbit-home-card h2 { font-size: 1.35rem; margin: .65rem 0 .4rem; }
.orbit-home-card strong { margin-top: auto; padding-top: 1rem; color: var(--accent); font-size: .85rem; }
.orbit-home-loop { display: grid; grid-template-columns: repeat(5, 1fr); gap: .5rem; margin: 2rem 0 3rem; }
.orbit-home-loop div { border-top: 2px solid var(--accent); padding-top: .7rem; }
.orbit-home-loop b { display: block; font: .72rem var(--font-mono); color: var(--accent); }
.orbit-home-loop span { display: block; font-size: .82rem; color: var(--muted); margin-top: .25rem; }
.orbit-home-note { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 1.5rem 0; display: flex; justify-content: space-between; gap: 2rem; align-items: baseline; }
.orbit-home-note p { max-width: 650px; margin: 0; color: var(--muted); }
.orbit-home-note a { white-space: nowrap; }

/* ---- responsive ---- */
@media (max-width: 900px) {
  .orbit-flow { grid-template-columns: 1fr; gap: .45rem; }
  .flow-arrow { transform: rotate(90deg); min-height: 1.2rem; }
  .orbit-handoff { grid-template-columns: 1fr; gap: .45rem; }
  .orbit-handoff .flow-arrow { transform: rotate(90deg); min-height: 1.2rem; }
  .loop-return { justify-content: flex-start; }
  .stale-flow { padding-top: 0; }
}
@media (max-width: 850px) {
  .orbit-nav { grid-template-columns: repeat(2, 1fr); }
  .orbit-home-grid { grid-template-columns: 1fr 1fr; }
  .orbit-home-loop { grid-template-columns: 1fr 1fr 1fr; }
}
@media (max-width: 720px) {
  .standards-grid { grid-template-columns: 1fr; }
  .header-top { display: block; }
  .header-actions { margin-top: 1rem; }
  .primary-nav { margin-top: 1rem; }
  header, footer { display: block; }
  nav { margin-top: 1rem; flex-wrap: wrap; }
  .split, .artefact-grid { grid-template-columns: 1fr; }
  .contrast, .comparison, .contrast-row { grid-template-columns: 1fr; }
  .rows p { display: block; }
  .rows span { display: block; margin-top: .2rem; }
  .card-grid { grid-template-columns: 1fr; }
  .guide-links { grid-template-columns: 1fr 1fr; }
  .adoption-steps, .adoption-records { grid-template-columns: 1fr; }
  .resource-grid { grid-template-columns: 1fr; }
  .resource-card { min-height: 0; }
  .field-table { font-size: .8rem; }
}
@media (max-width: 560px) {
  .orbit-nav { grid-template-columns: 1fr; }
  .orbit-home-grid, .orbit-home-loop { grid-template-columns: 1fr; }
  .orbit-home-note { display: block; }
  .orbit-home-note a { display: inline-block; margin-top: 1rem; }
}
@media (max-width: 480px) {
  .guide-links { grid-template-columns: 1fr; }
}
</style>
<script is:inline>
  Array.from(document.querySelectorAll('a[href^="http://"], a[href^="https://"]')).forEach((link) => {
    const anchor = /** @type {HTMLAnchorElement} */ (link);
    const url = new URL(anchor.href, window.location.href);
    if (url.origin !== window.location.origin) {
      anchor.target = '_blank';
      anchor.rel = 'noopener noreferrer';
    }
  });
</script>
