---
import { currentSite, sites } from '../lib/site';
const key = currentSite(import.meta.env.PUBLIC_SITE_KEY);
const site = sites[key];
const version = key === 'agdr' ? 'AgDR 1.2.0 · Published' : key === 'orbit' ? 'ORBIT v0.1 · Draft' : 'Agent SDLC · Early ecosystem';
const title = Astro.props.title ? `${Astro.props.title} — ${site.name}` : `${site.name} — ${site.kicker}`;
const nav = key === 'orbit' ? [['Concepts','/concepts'],['Quick Start','/quick-start'],['Specification','/specification'],['Schemas','/schemas'],['Reconciliation','/reconciliation'],['Execution Slices','/execution-slices'],['Implementation','/adopter-guide'],['Conformance','/conformance'],['Changelog','/changelog'],['Contribute','/contribute']] : key === 'agdr' ? [['Quick Start','/quick-start'],['Specification','/specification'],['Schema','/schema'],['Examples','/examples'],['Integrations','/integrations'],['Conformance','/conformance'],['Related standards','/related-standards']] : [['ORBIT','https://orbitspec.dev'],['AgDR','https://agdr.dev'],['Interoperability','/interoperability'],['About','/governance']];
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={site.description} /><meta property="og:title" content={title} /><meta property="og:description" content={site.description} /><meta property="og:url" content={`${site.canonicalUrl}${Astro.url.pathname}`} /><link rel="canonical" href={`${site.canonicalUrl}${Astro.url.pathname}`} /></head><body class={`${key}-site`}><header><div class="header-top"><div class="brand-line"><a href={key === 'agentsdlc' ? '/' : 'https://agentsdlc.ai'} class="brand">{key === 'agentsdlc' ? '~/agent-sdlc' : site.name}</a><span class="version">{version}</span></div><div class="header-actions">{key !== 'agentsdlc' && <a class="utility" href="https://agentsdlc.ai">Agent SDLC ↗</a>}<a class="utility" href={site.sourceRepo}>GitHub ↗</a><button class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme">☼</button></div></div><nav class={key === 'orbit' ? 'primary-nav orbit-nav' : 'primary-nav'}>{key === 'orbit' ? <><div><span>Learn</span><a href="/concepts">Concepts</a></div><div><span>Reference</span><a href="/specification">Specification</a><a href="/schemas">Schemas</a><a href="/reconciliation">Reconciliation</a><a href="/execution-slices">Execution slices</a></div><div><span>Adopt</span><a href="/adopter-guide">Adopter guide</a><a href="/conformance">Conformance</a></div><div><span>Project</span><a href="/changelog">Changelog</a><a href="/contribute">Contribute</a></div></> : nav.map(([label,href]) => <a href={href}>{label}</a>)}</nav></header><main><slot /></main><footer><span>ORBIT · Agent SDLC</span><a href="https://agentsdlc.ai">About Agent SDLC</a><a href={site.sourceRepo}>Source</a><a href="/contribute">Contribute</a></footer></body></html>
<script is:inline>
  const root = document.documentElement;
  const savedTheme = window.localStorage.getItem('orbit-theme');
  root.dataset.theme = savedTheme || 'light';
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    window.localStorage.setItem('orbit-theme', next);
  });
  const adoptLink = document.querySelector('.orbit-home .button[href="/quick-start"]');
  if (adoptLink) {
    adoptLink.setAttribute('href', '/adopter-guide');
    adoptLink.textContent = 'Start adopting ORBIT';
  }
  const guideLink = document.querySelector('.orbit-home-card[href="/adopter-guide"] strong');
  if (guideLink) guideLink.textContent = 'Open adopter guide →';
</script>
