---
import { currentSite, sites } from '../lib/site';
const key = currentSite(import.meta.env.PUBLIC_SITE_KEY);
const site = sites[key];
const version = key === 'agdr' ? 'AgDR 1.2.0 · Published' : key === 'orbit' ? 'ORBIT v0.1 · Draft' : 'Agent SDLC · Early ecosystem';
const title = Astro.props.title ? `${Astro.props.title} — ${site.name}` : `${site.name} — ${site.kicker}`;
const nav = key === 'orbit' ? [['Concepts','/concepts'],['Quick Start','/quick-start'],['Specification','/specification'],['Schemas','/schemas'],['Reconciliation','/reconciliation'],['Execution Slices','/execution-slices'],['Conformance','/conformance']] : key === 'agdr' ? [['Quick Start','/quick-start'],['Specification','/specification'],['Schema','/schema'],['Examples','/examples'],['Integrations','/integrations'],['Conformance','/conformance'],['Related standards','/related-standards']] : [['ORBIT','https://orbitspec.dev'],['AgDR','https://agdr.dev'],['Interoperability','/interoperability'],['About','/governance']];
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={site.description} /><meta property="og:title" content={title} /><meta property="og:description" content={site.description} /><meta property="og:url" content={`${site.canonicalUrl}${Astro.url.pathname}`} /><link rel="canonical" href={`${site.canonicalUrl}${Astro.url.pathname}`} /></head><body><header><div class="header-top"><a href={key === 'agentsdlc' ? '/' : 'https://agentsdlc.ai'} class="brand">{key === 'agentsdlc' ? '~/agent-sdlc' : site.name}</a><span class="version">{version}</span><nav>{nav.map(([label,href]) => <a href={href}>{label}</a>)}</nav><a class="utility" href={site.sourceRepo}>GitHub ↗</a></div>{key !== 'agentsdlc' && <nav class="local-nav"><a href={key === 'orbit' ? '/' : 'https://agentsdlc.ai'}>Agent SDLC</a>{nav.map(([label,href]) => <a href={href}>{label}</a>)}</nav>}</header><main><slot /></main><footer><span>Part of Agent SDLC</span><a href="https://agentsdlc.ai">agentsdlc.ai</a><a href={site.sourceRepo}>View source</a></footer></body></html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#17202a;background:#f7f8fa;line-height:1.6}body{margin:0}header,main,footer{max-width:1120px;margin:auto;padding:1.25rem 1.5rem}header{border-bottom:1px solid #d8dee6}.header-top{display:flex;gap:1rem;justify-content:space-between;align-items:center}.local-nav{display:flex;gap:1rem;padding-top:1rem;font-size:.82rem;flex-wrap:wrap}.brand{font-weight:700;color:#17202a;text-decoration:none}.version,.pathbar,.section-label,.meta{font: .72rem/1.4 "SFMono-Regular",Consolas,monospace;color:#5e6b78}.version{font-size:.75rem}nav{display:flex;gap:1rem;font-size:.9rem}.utility{font: .72rem "SFMono-Regular",Consolas,monospace;text-decoration:none;white-space:nowrap}a{color:#174ea6}nav a,footer a{text-decoration:none}.page{padding:4rem 0 5rem;max-width:900px}.pathbar{margin:0 0 2.5rem;color:#174ea6}.eyebrow,.section-label{letter-spacing:.12em;text-transform:uppercase;color:#174ea6;font-weight:700}.page h1{font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.05;letter-spacing:-.05em;margin:.5rem 0 1rem}.page h2{font-size:clamp(1.8rem,4vw,3rem);margin:.6rem 0 1rem;line-height:1.12;letter-spacing:-.03em}.lede{font-size:1.2rem;color:#5e6b78;max-width:700px}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:2rem 0 3rem}.button{display:inline-block;background:#1769e0;color:#fff;padding:.65rem 1rem;border-radius:.3rem;text-decoration:none;font-weight:650}.button.quiet{background:transparent;color:#174ea6;border:1px solid #b8c5d4}.editorial{border-top:1px solid #cbd4de;padding:2.5rem 0;margin:3rem 0}.section-label{margin:0}.standard-name{font-size:clamp(2.2rem,6vw,4.5rem);line-height:1;letter-spacing:-.06em;margin:1.2rem 0 .4rem;font-weight:750;color:#17202a}.meta{color:#5e6b78}.artefact{border:1px solid #b8c5d4;background:#fff;padding:1.5rem;margin:2rem 0}.code,.terminal{font: .88rem/1.55 "SFMono-Regular",Consolas,monospace;white-space:pre-wrap;background:#17202a;color:#e8eef5;padding:1.25rem;border-radius:.25rem;overflow:auto}.terminal{background:#0e151d}.split{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start;border-top:1px solid #cbd4de;padding:2.5rem 0;margin:2.5rem 0}.contrast,.comparison{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.contrast p,.comparison p{border-left:2px solid #1769e0;padding-left:1rem}.rows p{display:flex;justify-content:space-between;gap:1rem;border-bottom:1px solid #d8dee6;padding:.8rem 0}.rows span{color:#5e6b78}.lifecycle{border:1px solid #b8c5d4;background:#fff;padding:1.5rem;margin:2rem 0}.stage{display:flex;gap:1.5rem;padding:1rem 0;border-bottom:1px solid #d8dee6}.stage:last-child{border-bottom:0}.stage b{font: .78rem "SFMono-Regular",Consolas,monospace;color:#174ea6;min-width:6rem}.stage span{color:#5e6b78}.artefact-grid{grid-template-columns:1fr 1fr}.artefact-grid .code{min-height:150px}.trust-strip{display:flex;gap:1rem;flex-wrap:wrap;border-top:1px solid #cbd4de;padding:1.25rem 0;margin-top:3rem;font:.72rem "SFMono-Regular",Consolas,monospace;color:#5e6b78}.trust-strip span{padding-right:1rem;border-right:1px solid #cbd4de}footer{display:flex;gap:1rem;border-top:1px solid #d8dee6;color:#5e6b78;font-size:.9rem}footer a{display:inline-block}@media(max-width:720px){.header-top{display:block}.header-top nav{margin-top:1rem}header,footer{display:block}nav{margin-top:1rem;flex-wrap:wrap}.split,.artefact-grid{grid-template-columns:1fr}.contrast,.comparison{grid-template-columns:1fr}.rows p{display:block}.rows span{display:block;margin-top:.2rem}}
@media(prefers-color-scheme:dark){:root{color:#e8eef5;background:#111820}.brand{color:#e8eef5}.card,.callout{background:#17202a;border-color:#3a4653}.callout{border-top-color:#98a5b3}.lede,footer{color:#aebdca}header,footer{border-color:#3a4653}}
</style>
